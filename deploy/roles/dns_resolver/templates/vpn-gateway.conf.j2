# Managed by ansible (dns_resolver).
server:
    # Listen on the gateway's tunnel addresses only. freebind lets unbound start before
    # wg0 exists, so the boot order of the two services does not matter.
    interface: {{ tunnel_ipv4_prefix }}.0.1
    interface: {{ tunnel_ipv6_prefix }}::1
    ip-freebind: yes

    access-control: 0.0.0.0/0 refuse
    access-control: ::0/0 refuse
    access-control: {{ tunnel_ipv4_prefix }}.0.0/16 allow
    access-control: {{ tunnel_ipv6_prefix }}::/64 allow

    # Query upstream over IPv6 only where the gateway has it.
    do-ip6: {{ 'yes' if ipv6_egress else 'no' }}

    hide-identity: yes
    hide-version: yes
    qname-minimisation: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-referral-path: yes
    use-caps-for-id: yes
    aggressive-nsec: yes
    prefetch: yes

    # Addresses in private ranges are not returned for public names, which blocks DNS
    # rebinding against whatever is on the client's own network.
    private-address: 10.0.0.0/8
    private-address: 172.16.0.0/12
    private-address: 192.168.0.0/16
    private-address: 169.254.0.0/16
    private-address: fd00::/8
    private-address: fe80::/10
