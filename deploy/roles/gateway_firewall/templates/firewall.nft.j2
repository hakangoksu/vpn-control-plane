#!/usr/sbin/nft -f
# Managed by ansible (gateway_firewall).
#
# One table, replaced as a whole on every load, so this file is the complete statement
# of what the gateway lets tunnel clients do. It never flushes the rest of the ruleset.

table inet vpn_gateway
delete table inet vpn_gateway

table inet vpn_gateway {
    set blocked_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ gateway_blocked_ipv4 | join(', ') }} }
    }

    set blocked_v6 {
        type ipv6_addr
        flags interval
        elements = { {{ gateway_blocked_ipv6 | join(', ') }} }
    }

    chain forward {
        # Runs before the host's own forward rules, so a drop or reject here is final
        # whatever ufw or Docker would have decided. Only packets to or from wg0 are
        # looked at; everything else the host forwards passes through untouched.
        type filter hook forward priority filter - 10; policy {{ gateway_forward_policy }};

        iifname "wg0" jump from_tunnel

        # Replies to connections a client opened. Nothing on the internet can open a new
        # connection to a client through the gateway.
        oifname "wg0" ct state established,related accept
        oifname "wg0" drop
    }

    chain from_tunnel {
        ct state invalid drop

        # Clients cannot reach each other. Each one sees the internet, not its neighbours.
        oifname "wg0" drop

        ip daddr @blocked_v4 drop
        ip6 daddr @blocked_v6 drop

        # Outbound mail from a VPN address is almost always spam, and it would get this
        # gateway's address onto blocklists that then hurt every other client.
        tcp dport { 25, 465, 587 } drop

        # Only addresses the control plane hands out may leave. A client that invents a
        # source address is dropped rather than NATed.
        oifname "{{ uplink_interface }}" ip saddr {{ tunnel_ipv4_prefix }}.0.0/16 accept
{% if ipv6_egress %}
        oifname "{{ uplink_interface }}" ip6 saddr {{ tunnel_ipv6_prefix }}::/64 accept
{% else %}
        # This gateway has no IPv6 route to the internet. The client still sends IPv6 into
        # the tunnel, so none of it can leak around it, and here it is refused with an
        # immediate ICMPv6 error. A silent drop would make every IPv6 attempt wait for a
        # timeout before the application fell back to IPv4.
        meta nfproto ipv6 reject with icmpv6 type admin-prohibited
{% endif %}

        drop
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "{{ uplink_interface }}" ip saddr {{ tunnel_ipv4_prefix }}.0.0/16 masquerade
{% if ipv6_egress %}
        oifname "{{ uplink_interface }}" ip6 saddr {{ tunnel_ipv6_prefix }}::/64 masquerade
{% endif %}
    }
}
