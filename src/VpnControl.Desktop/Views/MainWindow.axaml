<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VpnControl.Desktop.ViewModels"
        xmlns:views="using:VpnControl.Desktop.Views"
        x:Class="VpnControl.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1000" Height="680"
        MinWidth="860" MinHeight="580"
        Background="{StaticResource WindowBrush}">

  <!--
    Two panes. The left one answers the question the user opened the window for (am I
    protected, and where does my traffic leave) and holds the one action that changes it.
    The right one is the choice of location. Diagnostics are there for whoever needs them,
    folded away by default.
  -->
  <Grid ColumnDefinitions="360,*">

    <Border Grid.Column="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="28,24">
      <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Classes="label" Text="VPN CONTROL PLANE" Margin="0,0,0,20" />

        <!-- Kept at the bottom of the pane so the status and the action read first. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="14">
          <Border Height="1" Background="{StaticResource BorderBrush}" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="body" Text="Kill switch" FontWeight="Medium" />
              <TextBlock Classes="caption"
                         Text="Routes all traffic into the tunnel while connected." />
            </StackPanel>
            <!-- Driven by a command rather than a two-way binding: changing it on a live
                 session rebuilds the tunnel, which a property setter cannot do honestly. -->
            <ToggleSwitch Grid.Column="1"
                          OnContent="" OffContent=""
                          IsChecked="{Binding Connection.KillSwitchEnabled, Mode=OneWay}"
                          Command="{Binding ToggleKillSwitchCommand}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Kill switch" />
          </Grid>
          <TextBlock Classes="caption" Text="{Binding Connection.TunnelDescription}" />
        </StackPanel>

        <StackPanel Spacing="20">

          <!-- A client that leaves the user unsure whether traffic is protected is worse
               than one that refuses to connect, so simulation is stated up front. -->
          <Border Background="#2A2210" BorderBrush="#5C4715" BorderThickness="1" CornerRadius="6" Padding="12,10"
                  IsVisible="{Binding Connection.IsSimulated}">
            <TextBlock Classes="secondary" Foreground="{StaticResource WarningBrush}"
                       Text="Demo mode. The tunnel is simulated and the locations are fictional; no traffic is protected." />
          </Border>

          <views:ConnectionView DataContext="{Binding Connection}" />

          <StackPanel Spacing="6">
            <Button Classes="cta"
                    Classes.quiet="{Binding PrimaryDisconnects}"
                    Content="{Binding PrimaryActionText}"
                    Command="{Binding PrimaryCommand}" />
            <Button Classes="link"
                    HorizontalAlignment="Center"
                    Content="Connect to the fastest location"
                    Command="{Binding ConnectToFastestCommand}" />
          </StackPanel>

          <Border Background="#2A1517" BorderBrush="#6E2A2E" BorderThickness="1" CornerRadius="6" Padding="12,10"
                  IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="secondary" Foreground="#F4A6A2" Text="{Binding Error}" />
          </Border>

        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="28,24,28,16">
      <views:ServerListView DataContext="{Binding ServerList}" />

      <Expander Grid.Row="1"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                IsExpanded="False">
        <Expander.Header>
          <TextBlock Classes="secondary" Text="Diagnostics" />
        </Expander.Header>
        <views:LogView DataContext="{Binding Log}" Height="200" />
      </Expander>
    </Grid>

  </Grid>

</Window>
