<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnControl.Desktop.ViewModels"
             x:Class="VpnControl.Desktop.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

  <StackPanel Spacing="20">

    <!-- The headline: protected or not, in the words the user thinks in. The dot's colour
         comes from the state, so the in-between states never borrow the connected green. -->
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                 Fill="{Binding State, Converter={StaticResource StateBrush}}" />
        <TextBlock Classes="headline" Text="{Binding Headline}" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
    </StackPanel>

    <!-- Session figures, only while there is a session. Four numbers in a grid, labels
         above values, all aligned to the same edges. -->
    <Border IsVisible="{Binding HasSession}"
            Background="{StaticResource RaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,14">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="14">
        <StackPanel Spacing="3">
          <TextBlock Classes="label" Text="DURATION" />
          <TextBlock Classes="metric" Text="{Binding ElapsedText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Classes="label" Text="LAST HANDSHAKE" />
          <TextBlock Classes="metric" Text="{Binding HandshakeText}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="3">
          <TextBlock Classes="label" Text="DOWNLOADED" />
          <TextBlock Classes="metric" Text="{Binding BytesReceivedText}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
          <TextBlock Classes="label" Text="UPLOADED" />
          <TextBlock Classes="metric" Text="{Binding BytesSentText}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
          <TextBlock Classes="label" Text="PROTECTED TRAFFIC" />
          <TextBlock Classes="body" Text="{Binding Ipv6Text}" />
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>

</UserControl>
