<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnControl.Desktop.ViewModels"
             x:Class="VpnControl.Desktop.Views.ServerListView"
             x:DataType="vm:ServerListViewModel">

  <!--
    x:DataType turns every binding below into a compiled binding, checked against the
    view model at build time. A renamed property then breaks the build instead of
    producing an empty column at runtime.
  -->

  <Grid RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <TextBlock Classes="section" Text="Locations" VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="subtle"
              Content="Refresh"
              Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsRefreshing}" />
    </Grid>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Servers}"
             SelectedItem="{Binding SelectedServer}"
             Background="Transparent"
             BorderThickness="0"
             AutomationProperties.Name="Locations">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="14,10" />
          <Setter Property="Margin" Value="0,0,0,6" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
          <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        </Style>
      </ListBox.Styles>

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ServerRowViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="14"
                ToolTip.Tip="{Binding Details}"
                Opacity="{Binding IsEligible, Converter={StaticResource EligibilityOpacity}}">

            <!-- Country code in place of a flag glyph, which not every platform renders. -->
            <Border Width="34" Height="24" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding CountryCode}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="body" FontWeight="Medium" Text="{Binding City}" VerticalAlignment="Center" />
                <Border Classes="tag accent" IsVisible="{Binding IsFastest}">
                  <TextBlock Text="Fastest" />
                </Border>
                <Border Classes="tag" IsVisible="{Binding !HasIpv6}">
                  <TextBlock Text="IPv4 only" />
                </Border>
                <Border Classes="tag" IsVisible="{Binding IsBusy}">
                  <TextBlock Text="Busy" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Marks the location in use, which the selection does not: a user can
                     select a row without connecting to it. -->
                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                         VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                <TextBlock Classes="caption" Foreground="{StaticResource SuccessBrush}"
                           Text="Connected" IsVisible="{Binding IsCurrent}" />
                <TextBlock Classes="caption" Text="{Binding Name}" IsVisible="{Binding !IsCurrent}" />
              </StackPanel>
            </StackPanel>

            <!-- Quality as three neutral bars and the figure beside it. Colour is kept for
                 states that need action, and 150 ms is not one. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" Margin="0,0,0,3">
                <Rectangle Width="4" Height="6" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                           Fill="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=1}" />
                <Rectangle Width="4" Height="10" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                           Fill="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=2}" />
                <Rectangle Width="4" Height="14" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                           Fill="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=3}" />
              </StackPanel>
              <TextBlock Classes="secondary" Text="{Binding LatencyText}" MinWidth="52"
                         TextAlignment="Right" FontFeatures="+tnum" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="2">
      <TextBlock Classes="caption" Text="{Binding Status}" />
      <TextBlock Classes="caption" Text="{Binding ProbeDescription}" />
    </StackPanel>

  </Grid>

</UserControl>
