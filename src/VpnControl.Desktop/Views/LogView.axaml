<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnControl.Desktop.ViewModels"
             x:Class="VpnControl.Desktop.Views.LogView"
             x:DataType="vm:LogViewModel">

  <Grid RowDefinitions="*,Auto">

    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
      <!-- An ItemsControl inside a scroller rather than a ListBox: these rows are read,
           never selected, and a ListBox would add selection and focus behaviour that has
           no meaning here. -->
      <ScrollViewer Padding="10,8">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogEntry">
              <Grid ColumnDefinitions="64,44,*" Margin="0,1">
                <TextBlock Text="{Binding TimeText}" FontFamily="monospace" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LevelText}"
                           FontFamily="monospace"
                           FontSize="11"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="monospace" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           ToolTip.Tip="{Binding Category}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="1" Classes="link" HorizontalAlignment="Right" Content="Clear" Command="{Binding ClearCommand}" Margin="0,4,0,0" />

  </Grid>

</UserControl>
