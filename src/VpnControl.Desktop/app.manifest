<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!--
    A Win32 application manifest. It is ignored on Linux and macOS, and it matters on
    Windows for two reasons: without the DPI declaration the window is bitmap stretched
    on a scaled display, and without the compatibility section Windows applies
    behaviour from an older release.

    The requestedExecutionLevel is asInvoker on purpose. A VPN client does need
    privileges to create a network interface, and the correct place for them is a
    separate privileged helper, not the process that loads the UI framework. See
    WindowsServiceTunnel for the longer version of that argument.
  -->

  <assemblyIdentity version="1.0.0.0" name="VpnControl.Desktop" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 report the same GUID. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>
