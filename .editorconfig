# Shared formatting and analysis rules for the whole solution.
# Editors and the compiler both read this file, so a build is enough to
# catch most style drift without anyone having to remember the rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,axaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Using directives: System first, outside the namespace, no blank-line grouping.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Namespaces use the file-scoped form, which removes one level of indentation.
csharp_style_namespace_declarations = file_scoped:warning

# Prefer the modern, terser forms where they do not hide meaning.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

# Immutability and explicit intent.
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Naming: interfaces start with I, private fields use _camelCase.
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_camel_case.symbols = private_field_symbols
dotnet_naming_rule.private_fields_are_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Async methods that never await are almost always a mistake in this codebase.
dotnet_diagnostic.CS1998.severity = error
# An unawaited task is the other half of the same mistake.
dotnet_diagnostic.CS4014.severity = error

[tests/**/*.cs]
# Test classes are discovered by the runner, so public members without XML
# documentation are expected here.
dotnet_diagnostic.CS1591.severity = none
