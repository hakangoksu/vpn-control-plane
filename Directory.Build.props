<Project>

  <!--
    Properties shared by every project in the solution. Keeping them here means
    a new project inherits the same language level, nullable settings and
    warning policy without anyone copying a csproj by hand.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Warnings are cheap to fix now and expensive to ignore later. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <NeutralLanguage>en</NeutralLanguage>

    <!--
      CA1848 asks for compiled LoggerMessage delegates instead of the
      ILogger.LogInformation extension methods. That is sound advice for a hot
      path, and the wrong trade here: it would replace every readable log
      statement with a partial method declaration and an attribute, for a saving
      that does not register on a client that logs a handful of lines per session.
      The rule is off rather than suppressed one call at a time so the reason is
      recorded in one place.
    -->

    <!--
      CA1873, new in the .NET 10 analyzers, is the same concern from the other side: an
      argument evaluated even when its log level is off. Nearly every call it flags passes a
      property or a field, which costs nothing; the one call that built a string is guarded
      with IsEnabled instead. Off for the same reason as CA1848.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

</Project>
